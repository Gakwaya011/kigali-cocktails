# Postgres connection string (Neon or any Postgres host)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Port the Express server listens on
PORT=5000

# The frontend origin allowed to make credentialed (cookie) requests
FRONTEND_URL="http://localhost:5173"

# Long random string used to sign JWTs — generate your own, don't reuse this
JWT_SECRET="replace-with-a-long-random-string"

# Used only by `npm run db:seed` to create the first admin account.
# Change the password after first login; this is only for bootstrapping.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@kigaliluxurycocktails.com"
ADMIN_PASSWORD="change-me-after-first-login"

# Optional. Copy the "API Environment variable" connection string from your
# Cloudinary dashboard (Settings > API Keys) and paste it here as-is — it
# looks like cloudinary://<api_key>:<api_secret>@<cloud_name>. When this is
# set, gallery uploads go to Cloudinary instead of local disk, which is what
# you want in production (most hosts wipe local files on every deploy).
# Leave it unset for local dev if you don't want to use a Cloudinary account.
CLOUDINARY_URL=""
